CHAT_HOST=chat.srv1619516.hstgr.cloud
SITE_NAME=Ask My Site
LLM_MODEL=LiquidAI/LFM3-1.7B
REQUESTS_PER_MINUTE=3
REQUESTS_PER_HOUR=20
MAX_MODEL_REQUESTS=1
MAX_QUESTION_CHARS=800
MIN_SEMANTIC_SCORE=0.22
MIN_LEXICAL_SCORE=2.0
ALLOWED_ORIGINS=https://chat.srv1619516.hstgr.cloud,https://tomvsaji.com,https://www.tomvsaji.com

# Native search agent and private conversation memory
MAX_AGENT_SEARCHES=3
MAX_SESSION_TURNS=40
MEMORY_TTL_DAYS=7
RECENT_HISTORY_MESSAGES=4

# API security; keep Turnstile off until the frontend supports it.
TRUSTED_PROXY_CIDRS=
MAX_RATE_LIMIT_CLIENTS=4096
GLOBAL_REQUESTS_PER_MINUTE=10
GLOBAL_REQUESTS_PER_HOUR=100
MAX_BODY_BYTES=10000
MAX_HTTP_CONNECTIONS=32
REQUEST_READ_TIMEOUT=15
RESPONSE_WRITE_TIMEOUT=15
TURNSTILE_REQUIRED=false
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_HOSTNAMES=tomvsaji.com,www.tomvsaji.com
TURNSTILE_EXPECTED_ACTION=site_chat
TURNSTILE_TIMEOUT=5
