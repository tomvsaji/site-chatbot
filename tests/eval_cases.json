{
  "version": 2,
  "description": "Source-grounded, multi-turn evaluation set for the Tom Vellavoor Saji website chatbot.",
  "fallback": "I couldn't find that in Tom's published site data.",
  "scenarios": [
    {
      "id": "writing-catalog",
      "tags": ["core", "catalog", "retrieval"],
      "turns": [
        {
          "id": "topics",
          "question": "What does Tom write about?",
          "expect": {
            "sources": ["site-writing.md"],
            "concepts": [
              {"label": "AI engineering", "any_of": ["AI engineering"]},
              {"label": "agent systems", "any_of": ["agent systems", "agentic systems"]},
              {"label": "production LLM products", "any_of": ["production-ready LLM", "production LLM"]}
            ],
            "min_concepts": 3,
            "min_words": 12,
            "max_words": 90
          }
        },
        {
          "id": "post-list",
          "question": "What are some of his blog posts?",
          "expect": {
            "sources": ["site-writing.md"],
            "concepts": [
              {"label": "reliable SQL agents", "any_of": ["Building Reliable SQL Agents in Complex On-Prem SQL Environments"]},
              {"label": "SQL explorer", "any_of": ["How a SQL Agent Thinks: Walking Through the Explorer Pattern"]},
              {"label": "Composer 2", "any_of": ["Composer 2 vs Claude & Codex"]},
              {"label": "Dreamer", "any_of": ["Dreamer: The Personal Agent OS"]},
              {"label": "agent evaluation", "any_of": ["How to Evaluate AI Agent Systems in 2026"]}
            ],
            "min_concepts": 4,
            "forbidden": ["Why Dreamer Matters", "Lessons for AI engineers"],
            "min_words": 25,
            "max_words": 180
          }
        }
      ]
    },
    {
      "id": "composer-explanation",
      "tags": ["core", "conversation", "article", "reported-failure"],
      "turns": [
        {
          "id": "article-overview",
          "question": "Tell me about the lessons for AI engineers blog.",
          "expect": {
            "sources": ["posts/composer-2-vs-claude-codex.md"],
            "concepts": [
              {"label": "workflow specialization", "any_of": ["workflow", "specializ", "narrow domain"]},
              {"label": "production-like training", "any_of": ["environment you actually ship", "real IDE", "production-like", "real repositories"]},
              {"label": "reward design", "any_of": ["reward speed", "tool efficiency", "clean execution"]},
              {"label": "infrastructure alignment", "any_of": ["infrastructure", "serving", "cache"]},
              {"label": "domain benchmark", "any_of": ["domain benchmark", "internal benchmark"]}
            ],
            "min_concepts": 3,
            "min_words": 65,
            "max_words": 240
          }
        },
        {
          "id": "meaning-follow-up",
          "question": "What does this mean: Composer 2 is not just a product launch; it is a useful blueprint for people building specialized AI systems?",
          "expect": {
            "sources": ["posts/composer-2-vs-claude-codex.md"],
            "concepts": [
              {"label": "align the full system", "any_of": ["align", "alignment"]},
              {"label": "narrow workflow", "any_of": ["specific workflow", "narrow workflow", "vertical", "narrow domain"]},
              {"label": "training and evaluation", "any_of": ["training", "rewards", "evaluation"]},
              {"label": "product and infrastructure", "any_of": ["product", "infrastructure", "serving"]}
            ],
            "min_concepts": 3,
            "forbidden": ["not just a product launch. It is a useful blueprint"],
            "min_words": 55,
            "max_words": 220,
            "max_previous_similarity": 0.72
          }
        },
        {
          "id": "efficiency-why",
          "question": "Why is it so efficient according to Tom?",
          "expect": {
            "sources": ["posts/composer-2-vs-claude-codex.md"],
            "concepts": [
              {"label": "narrow coding specialization", "any_of": ["narrow domain", "programming tasks", "coding-specific", "specializ"]},
              {"label": "training-product runtime alignment", "any_of": ["shared runtime", "same kinds of environments", "real repositories", "real IDE"]},
              {"label": "production-oriented rewards", "any_of": ["tool efficiency", "speed", "clean execution", "rewards"]},
              {"label": "efficient architecture", "any_of": ["MoE", "MXFP8", "dense compute"]},
              {"label": "cache-aware serving", "any_of": ["KV-cache", "cache-friendly", "cache strategy"]},
              {"label": "lower-cost positioning", "any_of": ["lower cost", "pricing", "costing much less"]}
            ],
            "min_concepts": 4,
            "min_words": 75,
            "max_words": 250,
            "max_previous_similarity": 0.78
          }
        },
        {
          "id": "efficiency-clarification",
          "question": "But why does specialization itself make it more efficient?",
          "expect": {
            "sources": ["posts/composer-2-vs-claude-codex.md"],
            "concepts": [
              {"label": "avoids broad capability cost", "any_of": ["not paying for capabilities", "does not need", "doesn't need", "rather than every", "instead of general"]},
              {"label": "concentrates investment", "any_of": ["reinvest", "concentrat", "focus"]},
              {"label": "coding-specific optimization", "any_of": ["coding-specific training", "coding workflow", "programming tasks"]},
              {"label": "tighter useful distribution", "any_of": ["real software work", "narrow target", "specific workflow"]}
            ],
            "min_concepts": 3,
            "min_words": 55,
            "max_words": 190,
            "max_previous_similarity": 0.72
          }
        }
      ]
    },
    {
      "id": "sql-explorer-depth",
      "tags": ["core", "conversation", "article"],
      "turns": [
        {
          "id": "explorer-purpose",
          "question": "Why does the SQL explorer pattern inspect metadata before generating SQL?",
          "expect": {
            "sources": ["posts/how-a-sql-agent-thinks-explorer-pattern.md"],
            "concepts": [
              {"label": "wrong columns", "any_of": ["wrong column", "codes instead of labels"]},
              {"label": "wrong tables", "any_of": ["wrong table", "wrong source"]},
              {"label": "wrong joins", "any_of": ["wrong join", "relational key"]},
              {"label": "resolve ambiguity", "any_of": ["ambigu", "grounded discovery"]}
            ],
            "min_concepts": 3,
            "min_words": 60,
            "max_words": 220
          }
        },
        {
          "id": "explorer-steps",
          "question": "Walk me through the process.",
          "expect": {
            "sources": ["posts/how-a-sql-agent-thinks-explorer-pattern.md"],
            "concepts": [
              {"label": "discover tables", "any_of": ["list_tables", "available data sources", "discover"]},
              {"label": "inspect schema", "any_of": ["get_schema", "inspect schema"]},
              {"label": "resolve values", "any_of": ["get_distinct_values", "resolve filter"]},
              {"label": "generate after grounding", "any_of": ["generate SQL", "writes SQL"]},
              {"label": "security wrapper", "any_of": ["security wrapper", "security CTE", "permission"]},
              {"label": "failure handling", "any_of": ["retry", "failure", "clarification"]}
            ],
            "min_concepts": 5,
            "min_words": 100,
            "max_words": 300
          }
        },
        {
          "id": "distinct-count",
          "question": "Why does Tom use COUNT(DISTINCT employee_id) instead of COUNT(*) in the example?",
          "expect": {
            "sources": ["posts/how-a-sql-agent-thinks-explorer-pattern.md"],
            "concepts": [
              {"label": "multiple records per employee", "any_of": ["multiple absence records", "more than one absence record", "multiple daily records"]},
              {"label": "avoid overcounting", "any_of": ["overstate", "overcount", "inflated"]},
              {"label": "count people", "any_of": ["distinct employee", "unique employee"]}
            ],
            "min_concepts": 3,
            "min_words": 30,
            "max_words": 130
          }
        }
      ]
    },
    {
      "id": "dreamer-conversation",
      "tags": ["core", "conversation", "article"],
      "turns": [
        {
          "id": "dreamer-definition",
          "question": "What is Dreamer?",
          "expect": {
            "sources": ["posts/dreamer-personal-agent-os.md"],
            "concepts": [
              {"label": "cloud platform", "any_of": ["cloud platform"]},
              {"label": "personal agents", "any_of": ["personal agent", "Sidekick"]},
              {"label": "agent operating system", "any_of": ["operating system", "OS layer"]},
              {"label": "isolated VMs", "any_of": ["isolated VMs", "secure VMs"]}
            ],
            "min_concepts": 3,
            "min_words": 45,
            "max_words": 180
          }
        },
        {
          "id": "sidekick-role",
          "question": "What role does Sidekick play in it?",
          "expect": {
            "sources": ["posts/dreamer-personal-agent-os.md"],
            "concepts": [
              {"label": "main interface", "any_of": ["main interface", "center of Dreamer"]},
              {"label": "orchestrates other agents", "any_of": ["uses other agents", "coordinates", "orchestrat"]},
              {"label": "tools and data", "any_of": ["tools", "data"]},
              {"label": "permissions mediation", "any_of": ["permission", "mediates"]}
            ],
            "min_concepts": 3,
            "min_words": 55,
            "max_words": 200
          }
        },
        {
          "id": "dreamer-difference",
          "question": "How is that different from a normal chatbot?",
          "expect": {
            "sources": ["posts/dreamer-personal-agent-os.md"],
            "concepts": [
              {"label": "beyond a chat box", "any_of": ["single chat box", "not just answer", "beyond chat"]},
              {"label": "takes actions through agents", "any_of": ["other agents", "tools", "workflows"]},
              {"label": "composable capabilities", "any_of": ["composable", "building blocks", "functions"]},
              {"label": "persistent system layer", "any_of": ["OS", "operating system", "permissions", "database"]}
            ],
            "min_concepts": 3,
            "min_words": 65,
            "max_words": 220
          }
        }
      ]
    },
    {
      "id": "profile-and-categories",
      "tags": ["core", "facts", "category"],
      "turns": [
        {
          "id": "specialization",
          "question": "What does Tom specialize in?",
          "expect": {
            "sources": ["tom-facts.md"],
            "concepts": [
              {"label": "Azure AI", "any_of": ["Azure AI"]},
              {"label": "agentic systems", "any_of": ["agentic systems"]},
              {"label": "enterprise LLM platforms", "any_of": ["enterprise LLM"]},
              {"label": "production systems", "any_of": ["production AI systems"]}
            ],
            "min_concepts": 3,
            "min_words": 30,
            "max_words": 150
          }
        },
        {
          "id": "side-projects",
          "question": "What side projects has Tom built, and what does each one include?",
          "expect": {
            "sources": ["tom-facts.md"],
            "concepts": [
              {"label": "Agent Builder", "any_of": ["AI Agent Builder Platform"]},
              {"label": "Agent Builder features", "any_of": ["visual agent builder", "versioned configuration", "Docker deployment"]},
              {"label": "LangChain RAG Agent", "any_of": ["LangChain RAG Agent"]},
              {"label": "RAG Agent features", "any_of": ["persistent chat memory", "vector database", "full test suite"]}
            ],
            "min_concepts": 4,
            "forbidden": ["Botaina —", "Al Jazeera —"],
            "min_words": 55,
            "max_words": 220
          }
        },
        {
          "id": "category-negative",
          "question": "Is Botaina one of those side projects?",
          "expect": {
            "sources": ["tom-facts.md"],
            "concepts": [
              {"label": "not a side project", "any_of": ["not one", "not a side project"]},
              {"label": "production work", "any_of": ["production work", "enterprise AI chatbot"]}
            ],
            "min_concepts": 1,
            "forbidden": ["Botaina is one of"],
            "min_words": 8,
            "max_words": 100
          }
        }
      ]
    },
    {
      "id": "reliable-sql-article",
      "tags": ["extended", "article"],
      "turns": [
        {
          "id": "architecture-shift",
          "question": "Why did Tom shift to a unified explorer agent in the reliable SQL agents project?",
          "expect": {
            "sources": ["posts/building-reliable-sql-agents-in-complex-legacy-environments.md"],
            "concepts": [
              {"label": "reduce ambiguity", "any_of": ["ambigu"]},
              {"label": "centralize discovery", "any_of": ["unified", "central"]},
              {"label": "schema grounding", "any_of": ["schema", "metadata"]},
              {"label": "complex environment", "any_of": ["linked server", "multiple", "legacy"]}
            ],
            "min_concepts": 3,
            "min_words": 65,
            "max_words": 230
          }
        },
        {
          "id": "day-one-lessons",
          "question": "What would he do differently from day one?",
          "expect": {
            "sources": ["posts/building-reliable-sql-agents-in-complex-legacy-environments.md"],
            "concepts": [
              {"label": "data modernization", "any_of": ["data modernization", "data lake", "unified schema"]},
              {"label": "semantic model", "any_of": ["semantic model"]},
              {"label": "agent-friendly metadata", "any_of": ["agent-friendly metadata", "column descriptions", "join keys"]},
              {"label": "explorer from day one", "any_of": ["explorer pattern"]},
              {"label": "native access control", "any_of": ["native row-level security", "access control natively"]},
              {"label": "query-result caching", "any_of": ["query-result caching", "query result caching"]}
            ],
            "min_concepts": 5,
            "min_words": 85,
            "max_words": 270
          }
        }
      ]
    },
    {
      "id": "out-of-scope",
      "tags": ["core", "abstention", "safety"],
      "turns": [
        {
          "id": "favorite-food",
          "question": "What is Tom's favorite food?",
          "expect": {"abstain": true}
        },
        {
          "id": "current-weather",
          "question": "What is the weather in Doha today?",
          "expect": {"abstain": true}
        },
        {
          "id": "consulting-price",
          "question": "How much does Tom charge for consulting?",
          "expect": {"abstain": true}
        }
      ]
    },
    {
      "id": "topic-switch",
      "tags": ["core", "conversation", "abstention"],
      "turns": [
        {
          "id": "grounded-start",
          "question": "Which organizations are explicitly named on Tom's homepage?",
          "expect": {
            "sources": ["tom-facts.md"],
            "concepts": [
              {"label": "Qatar Foundation", "any_of": ["Qatar Foundation"]},
              {"label": "Al Jazeera", "any_of": ["Al Jazeera"]},
              {"label": "Qatar News Agency", "any_of": ["Qatar News Agency"]},
              {"label": "Invest Qatar", "any_of": ["Invest Qatar"]}
